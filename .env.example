# Copy to .env. Everything has a working default, so this file is optional.
# Docker Compose reads POSTGRES_* and ALERT_WEBHOOK_URL from here.

POSTGRES_USER=mlpipeline
POSTGRES_PASSWORD=mlpipeline
POSTGRES_DB=ml_inference

# Where drift alerts are POSTed as JSON (Slack incoming webhooks accept the "text" field). Empty disables it.
ALERT_WEBHOOK_URL=

# Used when running outside Docker. Defaults write to ./demo_state.
# DATABASE_URL=sqlite:///demo_state/predictions.db
# MLFLOW_TRACKING_URI=sqlite:///demo_state/mlflow.db

# Optional tuning
# DRIFT_THRESHOLD=0.05
# DRIFT_WINDOW_SIZE=100
# ALERT_COOLDOWN_SECONDS=3600
